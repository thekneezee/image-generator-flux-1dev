{
  "info": {
    "name": "FLUX.1-dev on Runpod Serverless",
    "description": "Requests for a custom Runpod Serverless endpoint running FLUX.1-dev.\n\nSet two collection variables before use:\n  ENDPOINT_ID     - from the Runpod console\n  RUNPOD_API_KEY  - Runpod Settings -> API Keys\n\nStart with 'Health'. Then 'Submit generation (async)', which saves the returned job id into JOB_ID automatically, so 'Check status' can be run repeatedly without copying anything by hand.\n\nNote: /runsync is included but blocks with a 90 second default ceiling, which a cold start plus a 50-step generation can exceed. Prefer /run + /status - it is also the only way to see per-step progress.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{RUNPOD_API_KEY}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "https://api.runpod.ai/v2/{{ENDPOINT_ID}}/health",
          "protocol": "https",
          "host": [
            "api",
            "runpod",
            "ai"
          ],
          "path": [
            "v2",
            "{{ENDPOINT_ID}}",
            "health"
          ]
        },
        "description": "Worker and job counts. Watch 'initializing' after a deployment and 'running' during a generation."
      },
      "response": []
    },
    {
      "name": "Submit generation (async)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{RUNPOD_API_KEY}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "https://api.runpod.ai/v2/{{ENDPOINT_ID}}/run",
          "protocol": "https",
          "host": [
            "api",
            "runpod",
            "ai"
          ],
          "path": [
            "v2",
            "{{ENDPOINT_ID}}",
            "run"
          ]
        },
        "description": "Queue a job and return immediately with an id. Max payload 10 MB; results retained 30 minutes.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"input\": {\n    \"prompt\": \"a red fox curled asleep in deep snow, dawn light through pine branches, photorealistic\",\n    \"width\": 1024,\n    \"height\": 1024,\n    \"num_inference_steps\": 28,\n    \"guidance\": 3.5,\n    \"seed\": 42,\n    \"image_format\": \"png\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "if (body.id) {",
              "    pm.collectionVariables.set('JOB_ID', body.id);",
              "    console.log('JOB_ID set to ' + body.id);",
              "}",
              "pm.test('queued', () => pm.expect(body.status).to.be.oneOf(",
              "    ['IN_QUEUE', 'IN_PROGRESS']));"
            ]
          }
        }
      ]
    },
    {
      "name": "Check status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{RUNPOD_API_KEY}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "https://api.runpod.ai/v2/{{ENDPOINT_ID}}/status/{{JOB_ID}}",
          "protocol": "https",
          "host": [
            "api",
            "runpod",
            "ai"
          ],
          "path": [
            "v2",
            "{{ENDPOINT_ID}}",
            "status",
            "{{JOB_ID}}"
          ]
        },
        "description": "Poll until COMPLETED. While IN_PROGRESS the 'output' field carries the handler's progress_update payload ({phase, step, total_steps, percent}); once terminal it becomes the actual result. That is how the UI narrates each denoising step."
      },
      "response": []
    },
    {
      "name": "Warm up the worker",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{RUNPOD_API_KEY}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "https://api.runpod.ai/v2/{{ENDPOINT_ID}}/run",
          "protocol": "https",
          "host": [
            "api",
            "runpod",
            "ai"
          ],
          "path": [
            "v2",
            "{{ENDPOINT_ID}}",
            "run"
          ]
        },
        "description": "Loads the model and returns without generating, so the next real request skips the cold start.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"input\": {\n    \"warmup\": true\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "Generate (sync)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{RUNPOD_API_KEY}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "https://api.runpod.ai/v2/{{ENDPOINT_ID}}/runsync",
          "protocol": "https",
          "host": [
            "api",
            "runpod",
            "ai"
          ],
          "path": [
            "v2",
            "{{ENDPOINT_ID}}",
            "runsync"
          ]
        },
        "description": "Blocks until finished. 20 MB payload limit, 90s default wait (raise with ?wait=, max 300000 ms). No progress visibility.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"input\": {\n    \"prompt\": \"a glass terrarium on a wooden desk, macro photograph\",\n    \"num_inference_steps\": 12,\n    \"seed\": 7\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "Cancel job",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{RUNPOD_API_KEY}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "https://api.runpod.ai/v2/{{ENDPOINT_ID}}/cancel/{{JOB_ID}}",
          "protocol": "https",
          "host": [
            "api",
            "runpod",
            "ai"
          ],
          "path": [
            "v2",
            "{{ENDPOINT_ID}}",
            "cancel",
            "{{JOB_ID}}"
          ]
        },
        "description": "Stops a queued or running job."
      },
      "response": []
    },
    {
      "name": "Invalid input (expect a clean error)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{RUNPOD_API_KEY}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "https://api.runpod.ai/v2/{{ENDPOINT_ID}}/runsync",
          "protocol": "https",
          "host": [
            "api",
            "runpod",
            "ai"
          ],
          "path": [
            "v2",
            "{{ENDPOINT_ID}}",
            "runsync"
          ]
        },
        "description": "Validation happens before the GPU is touched, so a bad request costs milliseconds. Expect ValidationError, not a stack trace.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"input\": {\n    \"prompt\": \"a fox\",\n    \"num_inference_steps\": 999\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "ENDPOINT_ID",
      "value": "",
      "description": "Runpod endpoint id"
    },
    {
      "key": "RUNPOD_API_KEY",
      "value": "",
      "description": "Runpod API key"
    },
    {
      "key": "JOB_ID",
      "value": "",
      "description": "Set automatically by Submit"
    }
  ]
}